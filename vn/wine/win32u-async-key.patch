+/* VNBox: one seqlock read of the calling thread's queue and, for key >= 0, one of its desktop's key state, with one
+ * thread data lookup (NtCurrentTeb -> pthread_getspecific) where get_shared_queue and get_shared_desktop do one per
+ * call. FALSE until get_shared_queue / get_shared_desktop have found the objects. */
+BOOL read_shared_queue_poll( struct shared_queue_poll *poll, INT key )
+{
+    const struct session_thread_data *data = get_session_thread_data();
+    const shared_object_t *object = data->shared_queue;
+    const queue_shm_t *queue_shm;
+    UINT64 seq;
+
+    if (!object) return FALSE;
+    queue_shm = &object->shm.queue;
+    do
+    {
+        shared_object_acquire_seqlock( object, &seq );
+        poll->access_time = queue_shm->access_time;
+        poll->wake_mask = queue_shm->wake_mask;
+        poll->wake_bits = queue_shm->wake_bits;
+        poll->changed_mask = queue_shm->changed_mask;
+        poll->changed_bits = queue_shm->changed_bits;
+        poll->internal_bits = queue_shm->internal_bits;
+    } while (!shared_object_release_seqlock( object, seq ));
+
+    if (key < 0) return TRUE;
+    if (!(object = data->shared_desktop)) return FALSE;
+    do
+    {
+        shared_object_acquire_seqlock( object, &seq );
+        poll->key_state = object->shm.desktop.keystate[key];
+    } while (!shared_object_release_seqlock( object, seq ));
+    return TRUE;
+}
