     RegCloseKey( key );
 }
 
+/* VNBox: SHGetFolderPathW loads shell32 and its imports, about 1 s in the emulator. For these
+ * folders the prefix's registry gives the same path shell32 would (profile = ProfilesDirectory
+ * plus the user name; others = User Shell Folders under %USERPROFILE%). Anything else, or a
+ * folder that doesn't exist yet, still goes through shell32. */
+static HRESULT get_folder_path( int csidl, const WCHAR *value, WCHAR *path )
+{
+    WCHAR dir[MAX_PATH], user[MAX_PATH], rest[MAX_PATH] = L"";
+    DWORD size = sizeof(dir), len = ARRAY_SIZE(user), attr;
+    static const WCHAR userprofileW[] = L"%USERPROFILE%";
+    const DWORD flags = RRF_RT_REG_SZ | RRF_RT_REG_EXPAND_SZ | RRF_NOEXPAND;
+
+    if (RegGetValueW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\ProfileList",
+                      L"ProfilesDirectory", flags, NULL, dir, &size ) || !dir[0] || wcschr( dir, '%' ))
+        goto fallback;
+    if (!GetUserNameW( user, &len )) goto fallback;
+    if (value)
+    {
+        size = sizeof(rest);
+        if (RegGetValueW( HKEY_CURRENT_USER, L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\User Shell Folders",
+                          value, flags, NULL, rest, &size )) goto fallback;
+        len = ARRAY_SIZE(userprofileW) - 1;
+        if (wcsnicmp( rest, userprofileW, len ) || (rest[len] && rest[len] != '\\') || wcschr( rest + len, '%' ))
+            goto fallback;
+        memmove( rest, rest + len, (wcslen( rest + len ) + 1) * sizeof(WCHAR) );
+    }
+    len = wcslen( dir );
+    if (dir[len - 1] == '\\') dir[--len] = 0;
+    if (len + 1 + wcslen( user ) + wcslen( rest ) >= MAX_PATH) goto fallback;
+    swprintf( path, MAX_PATH, L"%s\\%s%s", dir, user, rest );
+    attr = GetFileAttributesW( path );
+    if (attr != INVALID_FILE_ATTRIBUTES && (attr & FILE_ATTRIBUTE_DIRECTORY)) return S_OK;
+fallback:
+    return SHGetFolderPathW( NULL, csidl | CSIDL_FLAG_CREATE, NULL, SHGFP_TYPE_CURRENT, path );
+}
+
 static void create_volatile_environment_registry_key(void)
 {
     WCHAR path[MAX_PATH];
