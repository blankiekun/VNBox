+/* VNBox: cache of the assembled SPI_GETNONCLIENTMETRICS result. Building it reads 15 entries and then
+ * normalize_nonclientmetrics creates, selects, measures and deletes 3 fonts on the display DC, ~55 us per call in
+ * VNBox; games poll it every frame (Itsusora: once per loop pass, ~1300/s). Keyed by entry point, DPI argument and
+ * the thread's DPI awareness context (the entries' DPI scaling); dropped whenever any entry is saved (every
+ * SPI_SET*) or a font resource is added or removed (normalize measures fonts). WINE_VNBOX_SPI_CACHE=0 (URL option
+ * cheapSpi=0) turns it off. */
+static LONG ncm_cache_gen = 1;
+static pthread_mutex_t ncm_cache_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct
+{
+    LONG gen;
+    BOOL for_dpi;
+    UINT dpi;
+    UINT context;
+    NONCLIENTMETRICSW ncm;
+} ncm_cache[4];
+static unsigned int ncm_cache_next;
+
+void vnbox_ncm_cache_invalidate(void)
+{
+    InterlockedIncrement( &ncm_cache_gen );
+}
+
+static BOOL ncm_cache_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled == -1)
+    {
+        const char *env = getenv( "WINE_VNBOX_SPI_CACHE" );
+        enabled = !env || strcmp( env, "0" );
+    }
+    return enabled;
+}
+
+/* copies a cached result into ncm (all fields but cbSize; iPaddedBorderWidth only when cbSize has room for it, as
+ * the uncached paths do). Returns 0 on a hit, else the generation to store a result computed now under. */
+static LONG ncm_cache_get( NONCLIENTMETRICSW *ncm, BOOL for_dpi, UINT dpi )
+{
+    UINT context = get_thread_dpi_awareness_context(), cb = ncm->cbSize;
+    LONG gen;
+    unsigned int i;
+
+    pthread_mutex_lock( &ncm_cache_lock );
+    gen = ncm_cache_gen;
+    for (i = 0; i < ARRAY_SIZE(ncm_cache); i++)
+    {
+        if (ncm_cache[i].gen != gen || ncm_cache[i].for_dpi != for_dpi || ncm_cache[i].dpi != dpi ||
+            ncm_cache[i].context != context) continue;
+        memcpy( ncm, &ncm_cache[i].ncm, cb == sizeof(*ncm) ? sizeof(*ncm) : FIELD_OFFSET(NONCLIENTMETRICSW, iPaddedBorderWidth) );
+        pthread_mutex_unlock( &ncm_cache_lock );
+        ncm->cbSize = cb;
+        return 0;
+    }
+    pthread_mutex_unlock( &ncm_cache_lock );
+    return gen;
+}
+
+/* stores a full-size result computed under generation gen (a save since then makes it stale at once) */
+static void ncm_cache_put( const NONCLIENTMETRICSW *ncm, BOOL for_dpi, UINT dpi, LONG gen )
+{
+    UINT context = get_thread_dpi_awareness_context();
+    unsigned int i;
+
+    if (ncm->cbSize != sizeof(*ncm)) return;
+    pthread_mutex_lock( &ncm_cache_lock );
+    for (i = 0; i < ARRAY_SIZE(ncm_cache); i++)
+        if (ncm_cache[i].for_dpi == for_dpi && ncm_cache[i].dpi == dpi && ncm_cache[i].context == context) break;
+    if (i == ARRAY_SIZE(ncm_cache)) i = ncm_cache_next++ % ARRAY_SIZE(ncm_cache);
+    ncm_cache[i].gen = gen;
+    ncm_cache[i].for_dpi = for_dpi;
+    ncm_cache[i].dpi = dpi;
+    ncm_cache[i].context = context;
+    ncm_cache[i].ncm = *ncm;
+    pthread_mutex_unlock( &ncm_cache_lock );
+}
