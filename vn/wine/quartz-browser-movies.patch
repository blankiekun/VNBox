+static struct strmbase_pin *movie_get_pin(struct strmbase_filter *iface, unsigned int index)
+{
+    return NULL;
+}
+
+static void movie_destroy(struct strmbase_filter *iface)
+{
+    struct browser_movie *movie = impl_from_strmbase_filter(iface);
+
+    SetEvent(movie->stop_event);
+    WaitForSingleObject(movie->thread, INFINITE);
+    CloseHandle(movie->thread);
+    CloseHandle(movie->stop_event);
+    CloseHandle(movie->device);
+    video_window_cleanup(&movie->window);
+    strmbase_seeking_cleanup(&movie->seeking);
+    strmbase_filter_cleanup(&movie->filter);
+    free(movie);
+}
+
+static HRESULT movie_query_interface(struct strmbase_filter *iface, REFIID iid, void **out)
+{
+    struct browser_movie *movie = impl_from_strmbase_filter(iface);
+
+    if (IsEqualGUID(iid, &IID_IVideoWindow))
+        *out = &movie->window.IVideoWindow_iface;
+    else if (IsEqualGUID(iid, &IID_IBasicVideo))
+        *out = &movie->window.IBasicVideo_iface;
+    else if (IsEqualGUID(iid, &IID_IMediaSeeking))
+        *out = &movie->seeking.IMediaSeeking_iface;
+    else if (IsEqualGUID(iid, &IID_IBasicAudio))
+        *out = &movie->IBasicAudio_iface;
+    else
+        return E_NOINTERFACE;
+
+    IUnknown_AddRef((IUnknown *)*out);
+    return S_OK;
+}
+
+static HRESULT movie_init_stream(struct strmbase_filter *iface)
+{
+    struct browser_movie *movie = impl_from_strmbase_filter(iface);
+
+    if (movie->window.AutoShow)
+        ShowWindow(movie->window.hwnd, SW_SHOW);
+    send_command(movie, "pause");
+    return S_OK;
+}
+
+static HRESULT movie_start_stream(struct strmbase_filter *iface, REFERENCE_TIME time)
+{
+    send_command(impl_from_strmbase_filter(iface), "run");
+    return S_OK;
+}
+
+static HRESULT movie_stop_stream(struct strmbase_filter *iface)
+{
+    send_command(impl_from_strmbase_filter(iface), "pause");
+    return S_OK;
+}
+
+static HRESULT movie_cleanup_stream(struct strmbase_filter *iface)
+{
+    send_command(impl_from_strmbase_filter(iface), "stop");
+    return S_OK;
+}
+
+static const struct strmbase_filter_ops filter_ops =
+{
+    .filter_get_pin = movie_get_pin,
+    .filter_destroy = movie_destroy,
+    .filter_query_interface = movie_query_interface,
+    .filter_init_stream = movie_init_stream,
+    .filter_start_stream = movie_start_stream,
+    .filter_stop_stream = movie_stop_stream,
+    .filter_cleanup_stream = movie_cleanup_stream,
+};
