diff --git a/dlls/wined3d/context_gl.c b/dlls/wined3d/context_gl.c
index 0b0515f..8174d21 100644
--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -5106,6 +5106,18 @@ void draw_primitive(struct wined3d_device *device, const struct wined3d_state *s
     if (!parameters->indirect && !parameters->u.direct.index_count)
         return;
 
+    /* With HLSL FFP, d3d8/d3d9/ddraw always bind a vertex shader (the stateblock binds an FFP one),
+     * so none bound is a d3d10/d3d11 draw without one, which draws nothing on Windows. The shader
+     * and FFP paths below all assume a vertex shader or a vertex declaration. */
+    if (device->adapter->d3d_info.ffp_hlsl && !state->shader[WINED3D_SHADER_TYPE_VERTEX])
+    {
+        static unsigned int skipped;
+
+        if (!(skipped++ % 1000))
+            ERR("No vertex shader bound, skipping draw (%u so far).\n", skipped);
+        return;
+    }
+
     if (!parameters->indirect)
         TRACE("base_vertex_idx %d, start_idx %u, index_count %u, start_instance %u, instance_count %u.\n",
                 parameters->u.direct.base_vertex_idx, parameters->u.direct.start_idx,
