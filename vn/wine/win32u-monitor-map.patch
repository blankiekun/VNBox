+/* VNBox: TRUE when map_monitor_rect between MDT_RAW_DPI and MDT_DEFAULT at dpi (0 = the monitor's own) returns rect
+ * unchanged on every monitor, so no monitor needs to be picked. Games poll GetCursorPos in their loop (Itsusora:
+ * ~2000/s) and each poll mapped the point through get_monitor_from_rect and map_monitor_rect's double math and roundf,
+ * all emulated. Identity holds when a monitor's virtual mode has its physical position and size (ratio 1, same
+ * centre) and dpi is 0 or the monitor's DPI (scale 1); the double steps are then exact and roundf is exact up to 2^24.
+ * Monitors that get_monitor_from_rect skips (inactive, clones) are checked too: stricter, never wrong. Reads only what
+ * lock_display_devices rebuilds, so a mode change or fullscreen switch is seen on the next call. display_lock must be
+ * held. */
+static BOOL monitor_map_is_identity( RECT rect, UINT dpi )
+{
+    const LONG max = 1 << 24;
+    struct monitor *monitor;
+
+    if (rect.left < -max || rect.left > max || rect.top < -max || rect.top > max ||
+        rect.right < -max || rect.right > max || rect.bottom < -max || rect.bottom > max) return FALSE;
+
+    LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
+    {
+        const struct source *source = monitor->source;
+
+        if (source && (source->current.dmPosition.x != source->physical.dmPosition.x ||
+                       source->current.dmPosition.y != source->physical.dmPosition.y ||
+                       source->current.dmPelsWidth != source->physical.dmPelsWidth ||
+                       source->current.dmPelsHeight != source->physical.dmPelsHeight ||
+                       !source->current.dmPelsWidth || !source->current.dmPelsHeight)) return FALSE;
+        /* with ratio 1, monitor_get_dpi( MDT_DEFAULT ) and ( MDT_RAW_DPI ) are both this */
+        if (dpi && dpi != (source && source->dpi ? source->dpi : system_dpi)) return FALSE;
+    }
+    return TRUE;
+}
