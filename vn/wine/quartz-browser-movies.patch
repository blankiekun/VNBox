+        DISPPARAMS *params, VARIANT *result, EXCEPINFO *excepinfo, UINT *error_arg)
+{
+    ITypeInfo *typeinfo;
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = strmbase_get_typeinfo(IBasicAudio_tid, &typeinfo)))
+    {
+        hr = ITypeInfo_Invoke(typeinfo, iface, id, flags, params, result, excepinfo, error_arg);
+        ITypeInfo_Release(typeinfo);
+    }
+    return hr;
+}
+
+static HRESULT WINAPI basic_audio_put_Volume(IBasicAudio *iface, LONG volume)
+{
+    struct browser_movie *movie = impl_from_IBasicAudio(iface);
+
+    if (volume > 0 || volume < -10000)
+        return E_INVALIDARG;
+    movie->volume = volume;
+    /* hundredths of a decibel -> thousandths of full scale */
+    send_command(movie, "volume %d", volume <= -10000 ? 0 : (int)(pow(10.0, volume / 2000.0) * 1000));
+    return S_OK;
+}
+
+static HRESULT WINAPI basic_audio_get_Volume(IBasicAudio *iface, LONG *volume)
+{
+    *volume = impl_from_IBasicAudio(iface)->volume;
+    return S_OK;
+}
+
+static HRESULT WINAPI basic_audio_put_Balance(IBasicAudio *iface, LONG balance)
+{
+    if (balance < -10000 || balance > 10000)
+        return E_INVALIDARG;
+    impl_from_IBasicAudio(iface)->balance = balance;
+    return S_OK;
+}
+
+static HRESULT WINAPI basic_audio_get_Balance(IBasicAudio *iface, LONG *balance)
+{
+    *balance = impl_from_IBasicAudio(iface)->balance;
+    return S_OK;
+}
