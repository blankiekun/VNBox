+/* S_OK with the filter when the page takes the file, else S_FALSE (render it the normal way). */
+HRESULT browser_movie_create(const WCHAR *path, IBaseFilter **out)
+{
+    struct browser_movie *movie;
+    REFERENCE_TIME duration;
+    LONG width, height;
+    HANDLE file, device;
+    char *unix_path;
+    BOOL ok;
+
+    *out = NULL;
+    file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return S_FALSE;
+    ok = probe_mpeg1_ps(file, &width, &height, &duration);
+    CloseHandle(file);
+    if (!ok)
+        return S_FALSE;
+
+    device = CreateFileW(L"\\\\?\\unix\\dev\\vnbox-movie", GENERIC_READ | GENERIC_WRITE,
+            FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL);
+    if (device == INVALID_HANDLE_VALUE)
+        return S_FALSE;
+    if (!(unix_path = wine_get_unix_file_name(path)) || !(movie = calloc(1, sizeof(*movie))))
+    {
+        HeapFree(GetProcessHeap(), 0, unix_path);
+        CloseHandle(device);
+        return S_FALSE;
+    }
+    movie->device = device;
+    send_command(movie, "open %s", unix_path);
+    HeapFree(GetProcessHeap(), 0, unix_path);
+    if (read_status(device) < 0)
+    {
+        CloseHandle(device);
+        free(movie);
+        return S_FALSE;
+    }
+
+    strmbase_filter_init(&movie->filter, NULL, &GUID_NULL, &filter_ops);
+    movie->format.bmiHeader.biSize = sizeof(movie->format.bmiHeader);
+    movie->format.bmiHeader.biWidth = width;
+    movie->format.bmiHeader.biHeight = height;
+    movie->format.bmiHeader.biPlanes = 1;
+    movie->format.bmiHeader.biBitCount = 32;
+    movie->pin.peer = &movie->pin.IPin_iface;
+    movie->pin.mt.majortype = MEDIATYPE_Video;
+    movie->pin.mt.subtype = MEDIASUBTYPE_RGB32;
+    movie->pin.mt.formattype = FORMAT_VideoInfo;
+    movie->pin.mt.cbFormat = sizeof(movie->format);
+    movie->pin.mt.pbFormat = (BYTE *)&movie->format;
+    video_window_init(&movie->window, &video_window_vtbl, &movie->filter, &movie->pin, &window_ops);
+    strmbase_seeking_init(&movie->seeking, &seeking_vtbl, seeking_change_stop_or_rate,
+            seeking_change_start, seeking_change_stop_or_rate);
+    movie->seeking.llDuration = movie->seeking.llStop = duration;
+    movie->IBasicAudio_iface.lpVtbl = &basic_audio_vtbl;
+    movie->stop_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+
+    if (FAILED(video_window_create_window(&movie->window))
+            || !(movie->thread = CreateThread(NULL, 0, watch_thread, movie, 0, NULL)))
+    {
+        CloseHandle(movie->stop_event);
+        CloseHandle(device);
+        video_window_cleanup(&movie->window);
+        strmbase_seeking_cleanup(&movie->seeking);
+        strmbase_filter_cleanup(&movie->filter);
+        free(movie);
+        return S_FALSE;
+    }
+
+    TRACE("Playing %s in the browser, %ldx%ld, %s.\n", debugstr_w(path), width, height, debugstr_time(duration));
+    *out = &movie->filter.IBaseFilter_iface;
+    return S_OK;
+}
