+static void glyph_stats_print(void)
+{
+    static int enabled = -1;
+    DWORD now;
+    char buf[1024];
+    int i, n;
+
+    if (enabled == -1) enabled = getenv( "VNBOX_GLYPHSTATS" ) != NULL;
+    if (!enabled) return;
+    now = NtGetTickCount();
+    if (now - glyph_stats.last < 2000) return;
+    n = snprintf( buf, sizeof(buf), "[glyphstats] %u ms:", (unsigned)(now - glyph_stats.last) );
+    for (i = 0; i < 0x20; i++)
+        if (glyph_stats.hit[i] || glyph_stats.miss[i] || glyph_stats.other[i])
+            n += snprintf( buf + n, sizeof(buf) - n, " fmt%x=%u/%u/%u", i, glyph_stats.hit[i], glyph_stats.miss[i],
+                           glyph_stats.other[i] );
+    snprintf( buf + n, sizeof(buf) - n, " (hit/miss/uncached) mat=%u fonts+%u-%u chars=%u charmiss=%u evicted=%u "
+              "cache=%uKB\n", glyph_stats.with_mat, glyph_stats.fonts_loaded, glyph_stats.fonts_destroyed,
+              glyph_stats.char_calls, glyph_stats.char_misses, glyph_stats.evicted,
+              (unsigned)(glyph_cache_bytes / 1024) );
+    fputs( buf, stderr );
+    memset( &glyph_stats, 0, sizeof(glyph_stats) );
+    glyph_stats.last = now;
+}
+
+/* VNBox: GDI text games map every char of their text to a glyph every frame (GetTextExtentPoint,
+ * GetGlyphOutline), and FT_Get_Char_Index searches the cmap each time. The charmap is fixed once
+ * the font is loaded. */
+static FT_UInt get_char_index( struct gdi_font *font, FT_ULong ch )
+{
+    struct font_private_data *data = font->private;
+    UINT *block;
+
+    glyph_stats_print();
+    glyph_stats.char_calls++;
+    if (ch > 0xffff) return pFT_Get_Char_Index( data->ft_face, ch );
+    if (!(block = data->char_index[ch >> 8]) && !(block = data->char_index[ch >> 8] = calloc( 256, sizeof(UINT) )))
+        return pFT_Get_Char_Index( data->ft_face, ch );
+    if (!block[ch & 0xff])
+    {
+        glyph_stats.char_misses++;
+        block[ch & 0xff] = pFT_Get_Char_Index( data->ft_face, ch ) + 1;
+    }
+    return block[ch & 0xff] - 1;
+}
