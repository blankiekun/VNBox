+/* VNBox: WebGL can't take BGRA, and swizzling every row here runs as emulated x86, per pixel, on every present. The
+ * engine's glTexSubImage2D does it as host code when given these formats (source/opengl/glcommon.cpp). An engine that
+ * doesn't know them answers the query with NULL, and the rows are converted below as before. */
+#define VNBOX_GL_QUERY_HOST_BGRA_UPLOAD 0x56420000
+#define VNBOX_GL_BGRX_TO_RGBA 0x56420001 /* alpha becomes 0xff */
+#define VNBOX_GL_BGRA_TO_RGBA 0x56420002
+
+static GLenum wined3d_texture_gl_webgl_host_format(enum wined3d_format_id format_id,
+        const struct wined3d_gl_info *gl_info)
+{
+    static int host_upload = -1;
+
+    if (host_upload < 0)
+    {
+        host_upload = !!gl_info->gl_ops.gl.p_glGetString(VNBOX_GL_QUERY_HOST_BGRA_UPLOAD);
+        /* The GL_INVALID_ENUM of an engine that doesn't know the query. */
+        while (gl_info->gl_ops.gl.p_glGetError());
+    }
+    if (!host_upload)
+        return 0;
+
+    switch (format_id)
+    {
+        case WINED3DFMT_B8G8R8X8_UNORM:
+        case WINED3DFMT_B8G8R8X8_UNORM_SRGB:
+            return VNBOX_GL_BGRX_TO_RGBA;
+
+        case WINED3DFMT_B8G8R8A8_UNORM:
+        case WINED3DFMT_B8G8R8A8_UNORM_SRGB:
+            return VNBOX_GL_BGRA_TO_RGBA;
+
+        default:
+            return 0;
+    }
+}
