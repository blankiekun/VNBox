+/* VNBox: rendered-glyph cache. GDI text games (BGI/Ethornell) call GetGlyphOutline for every glyph
+ * of their text every frame, and each call loaded, hinted and rasterized the glyph again. Entries
+ * hold the metrics, the return value and (once asked with a buffer) the bitmap of GGO_BITMAP and
+ * GGO_GRAY*_BITMAP glyphs, keyed by font, glyph index, format, matrix and tategaki; LRU, bounded by
+ * bytes. The font's entries go with the font (freetype_destroy_font). Callers hold font_lock. */
+struct glyph_cache_entry
+{
+    struct list         lru;
+    struct list         bucket;
+    struct gdi_font    *font;
+    UINT                glyph;
+    UINT                format;
+    BOOL                tategaki;
+    BOOL                has_mat;
+    MAT2                mat;  /* zero when no matrix */
+    GLYPHMETRICS        gm;
+    ABC                 abc;
+    UINT                needed;  /* return value */
+    BYTE               *bits;    /* needed bytes, NULL until asked with a buffer */
+};
+
+#define GLYPH_CACHE_BUCKETS 4096
+#define GLYPH_CACHE_MAX_BYTES (4 * 1024 * 1024)
+static struct list glyph_cache_lru = LIST_INIT( glyph_cache_lru );
+static struct list glyph_cache_buckets[GLYPH_CACHE_BUCKETS];
+
+static SIZE_T glyph_cache_entry_size( const struct glyph_cache_entry *entry )
+{
+    return sizeof(*entry) + (entry->bits ? entry->needed : 0);
+}
+
+static void glyph_cache_free( struct glyph_cache_entry *entry )
+{
+    glyph_cache_bytes -= glyph_cache_entry_size( entry );
+    ((struct font_private_data *)entry->font->private)->glyph_cache_entries--;
+    list_remove( &entry->lru );
+    list_remove( &entry->bucket );
+    free( entry->bits );
+    free( entry );
+}
+
+static void glyph_cache_remove_font( struct gdi_font *font )
+{
+    struct glyph_cache_entry *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &glyph_cache_lru, struct glyph_cache_entry, lru )
+        if (entry->font == font) glyph_cache_free( entry );
+}
+
+static BOOL glyph_cache_format( UINT format )
+{
+    switch (format & ~GGO_UNHINTED)
+    {
+    case GGO_BITMAP:
+    case GGO_GRAY2_BITMAP:
+    case GGO_GRAY4_BITMAP:
+    case GGO_GRAY8_BITMAP:
+    case WINE_GGO_GRAY16_BITMAP:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/*************************************************************
+ * freetype_get_glyph_outline
+ */
+static UINT freetype_get_glyph_outline( struct gdi_font *font, UINT glyph, UINT format,
+                                        GLYPHMETRICS *lpgm, ABC *abc, UINT buflen, void *buf,
+                                        const MAT2 *lpmat, BOOL tategaki )
+{
+    struct font_private_data *data = font->private;
+    struct glyph_cache_entry *entry;
+    struct list *bucket;
+    MAT2 mat;
+    UINT ret, hash;
+
+    glyph_stats_print();
+    if (lpmat) glyph_stats.with_mat++;
+    if (!glyph_cache_format( format ))
+    {
+        glyph_stats.other[format & 0x1f]++;
+        return get_glyph_outline_uncached( font, glyph, format, lpgm, abc, buflen, buf, lpmat, tategaki );
+    }
+
+    if (lpmat) mat = *lpmat;
+    else memset( &mat, 0, sizeof(mat) );
+    hash = ((UINT)(UINT_PTR)font >> 4) * 0x9e3779b1 ^ glyph * 0x85ebca6b ^ format ^ tategaki << 12;
+    bucket = &glyph_cache_buckets[(hash ^ hash >> 16) % GLYPH_CACHE_BUCKETS];
+    if (!bucket->next) list_init( bucket );
+
+    LIST_FOR_EACH_ENTRY( entry, bucket, struct glyph_cache_entry, bucket )
+    {
+        if (entry->font != font || entry->glyph != glyph || entry->format != format ||
+            entry->tategaki != tategaki || entry->has_mat != !!lpmat ||
+            memcmp( &entry->mat, &mat, sizeof(mat) )) continue;
+
+        /* same results as get_glyph_outline_uncached: metrics first, then the bitmap helpers' checks */
+        if (buf && buflen && !entry->bits && entry->needed && entry->needed <= buflen) break;  /* bitmap not cached yet */
+        list_remove( &entry->lru );
+        list_add_head( &glyph_cache_lru, &entry->lru );
+        glyph_stats.hit[format & 0x1f]++;
+        *lpgm = entry->gm;
+        *abc = entry->abc;
+        if (!buf || !buflen) return entry->needed;
+        if (!entry->needed || entry->needed > buflen) return GDI_ERROR;
+        memcpy( buf, entry->bits, entry->needed );
+        memset( (BYTE *)buf + entry->needed, 0, buflen - entry->needed );
+        return entry->needed;
+    }
+    if (&entry->bucket == bucket) entry = NULL;
+    glyph_stats.miss[format & 0x1f]++;
+
+    ret = get_glyph_outline_uncached( font, glyph, format, lpgm, abc, buflen, buf, lpmat, tategaki );
+    if (ret == GDI_ERROR) return ret;
+
+    if (!entry)
+    {
+        if (!(entry = calloc( 1, sizeof(*entry) ))) return ret;
+        entry->font = font;
+        entry->glyph = glyph;
+        entry->format = format;
+        entry->tategaki = tategaki;
+        entry->has_mat = !!lpmat;
+        entry->mat = mat;
+        entry->gm = *lpgm;
+        entry->abc = *abc;
+        entry->needed = ret;
+        list_add_head( bucket, &entry->bucket );
+        list_add_head( &glyph_cache_lru, &entry->lru );
+        glyph_cache_bytes += glyph_cache_entry_size( entry );
+        data->glyph_cache_entries++;
+    }
+    else
+    {
+        list_remove( &entry->lru );
+        list_add_head( &glyph_cache_lru, &entry->lru );
+    }
+
+    /* A GGO_BITMAP glyph loaded as a bitmap (no outline) leaves bytes of the buffer untouched, so
+     * only bitmaps the helpers fully wrote (outlines, or gray levels, which clear the buffer) are kept. */
+    if (buf && buflen && !entry->bits && ret == entry->needed &&
+        ((format & ~GGO_UNHINTED) != GGO_BITMAP || data->ft_face->glyph->format == FT_GLYPH_FORMAT_OUTLINE) &&
+        (entry->bits = malloc( ret )))
+    {
+        memcpy( entry->bits, buf, ret );
+        glyph_cache_bytes += ret;
+    }
+
+    while (glyph_cache_bytes > GLYPH_CACHE_MAX_BYTES)
+    {
+        struct glyph_cache_entry *old = LIST_ENTRY( list_tail( &glyph_cache_lru ), struct glyph_cache_entry, lru );
+        if (old == entry) break;
+        glyph_cache_free( old );
+        glyph_stats.evicted++;
+    }
+    return ret;
+}
