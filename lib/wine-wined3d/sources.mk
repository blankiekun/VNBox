# Host wined3d (HOST_WINED3D=1): what is compiled from the vendored Wine tree, and how. Read by
# project/emscripten/vnbox-wined3d.mk and by update.sh (keep each list on one line).
# The Vulkan backend (adapter_vk, context_vk, texture_vk, shader_spirv) is left out: browsers have no Vulkan.
WD3D_WINED3D_SRCS := dlls/wined3d/adapter_gl.c dlls/wined3d/buffer.c dlls/wined3d/context.c dlls/wined3d/context_gl.c dlls/wined3d/cs.c dlls/wined3d/decoder.c dlls/wined3d/device.c dlls/wined3d/directx.c dlls/wined3d/ffp_gl.c dlls/wined3d/ffp_hlsl.c dlls/wined3d/gl_compat.c dlls/wined3d/glsl_shader.c dlls/wined3d/palette.c dlls/wined3d/query.c dlls/wined3d/resource.c dlls/wined3d/sampler.c dlls/wined3d/shader.c dlls/wined3d/shader_sm1.c dlls/wined3d/shader_sm4.c dlls/wined3d/stateblock.c dlls/wined3d/surface.c dlls/wined3d/swapchain.c dlls/wined3d/texture.c dlls/wined3d/texture_gl.c dlls/wined3d/utils.c dlls/wined3d/vertexdeclaration.c dlls/wined3d/view.c dlls/wined3d/wined3d_main.c
# vkd3d-shader (wined3d's shader compiler) and the vkd3d-common helpers it uses; *.tab.c/*.yy.c are the
# bison/flex outputs update.sh generates, so the build needs neither tool.
WD3D_VKD3D_SRCS := libs/vkd3d/libs/vkd3d-common/blob.c libs/vkd3d/libs/vkd3d-common/debug.c libs/vkd3d/libs/vkd3d-common/error.c libs/vkd3d/libs/vkd3d-common/memory.c libs/vkd3d/libs/vkd3d-common/utf8.c libs/vkd3d/libs/vkd3d-shader/checksum.c libs/vkd3d/libs/vkd3d-shader/d3d_asm.c libs/vkd3d/libs/vkd3d-shader/d3dbc.c libs/vkd3d/libs/vkd3d-shader/dxbc.c libs/vkd3d/libs/vkd3d-shader/dxil.c libs/vkd3d/libs/vkd3d-shader/fx.c libs/vkd3d/libs/vkd3d-shader/glsl.c libs/vkd3d/libs/vkd3d-shader/hlsl.c libs/vkd3d/libs/vkd3d-shader/hlsl.tab.c libs/vkd3d/libs/vkd3d-shader/hlsl.yy.c libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c libs/vkd3d/libs/vkd3d-shader/hlsl_constant_ops.c libs/vkd3d/libs/vkd3d-shader/ir.c libs/vkd3d/libs/vkd3d-shader/msl.c libs/vkd3d/libs/vkd3d-shader/preproc.tab.c libs/vkd3d/libs/vkd3d-shader/preproc.yy.c libs/vkd3d/libs/vkd3d-shader/spirv.c libs/vkd3d/libs/vkd3d-shader/tpf.c libs/vkd3d/libs/vkd3d-shader/vkd3d_shader_main.c
# Wine's own flags for these files (from its generated Makefile), plus what wasm needs: __i386__ picks the 32-bit Win32
# layout in Wine's headers, -fshort-wchar makes wchar_t 2 bytes as on Windows. wcslen is renamed because libc's counts
# 4-byte characters and other host code uses it. WINE_NO_DEBUG_MSGS as jp.zip's wined3d.dll (vn/build-webgl-wined3d.sh):
# without it every checkGLcall is a glGetError, a synchronous WebGL round trip (~380 per frame at Muramasa's title).
WD3D_COMMON_FLAGS := -DWINE_NO_DEBUG_MSGS -D_UCRT -D_WIN32 -D__i386__ -fno-builtin -fshort-wchar -fno-strict-aliasing -Dwcslen=wd3d_wcslen -Wno-format -w
WD3D_WINED3D_FLAGS := -Idlls/wined3d -Iinclude -Iinclude/msvcrt -Ilibs/vkd3d/include -D__WINESRC__ $(WD3D_COMMON_FLAGS)
WD3D_VKD3D_FLAGS := -Ilibs/vkd3d -Iinclude -Iinclude/msvcrt -Ilibs/vkd3d/include -Ilibs/vkd3d/include/private -Ilibs/vkd3d/libs/vkd3d -Ilibs/vkd3d/libs/vkd3d-shader -DWINE_NO_NAMELESS_EXTENSION -DLIBVKD3D_SOURCE -DLIBVKD3D_SHADER_SOURCE -DLIBVKD3D_UTILS_SOURCE -DHAVE_SYNC_ADD_AND_FETCH -DHAVE_SYNC_BOOL_COMPARE_AND_SWAP $(WD3D_COMMON_FLAGS)
