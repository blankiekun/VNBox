+struct browser_movie
+{
+    struct strmbase_filter filter;
+    struct video_window window;
+    /* Never exposed: window.c only checks that its pin is connected and reads its format. */
+    struct strmbase_pin pin;
+    VIDEOINFOHEADER format;
+    SourceSeeking seeking;
+    IBasicAudio IBasicAudio_iface;
+    LONG volume, balance;
+
+    HANDLE device, thread, stop_event;
+    RECT shown;
+    BOOL ended;
+};
+
+static struct browser_movie *impl_from_strmbase_filter(struct strmbase_filter *iface)
+{
+    return CONTAINING_RECORD(iface, struct browser_movie, filter);
+}
+
+static void send_command(struct browser_movie *movie, const char *format, ...)
+{
+    char line[1024];
+    DWORD written;
+    va_list args;
+    int len;
+
+    va_start(args, format);
+    len = vsnprintf(line, sizeof(line), format, args);
+    va_end(args);
+    if (len > 0 && len < sizeof(line))
+        WriteFile(movie->device, line, len, &written, NULL);
+}
+
+/* -1: the page didn't take the file, 0: playing, 1: ended. */
+static int read_status(HANDLE device)
+{
+    char buffer[8] = {0};
+    DWORD size;
+
+    if (!ReadFile(device, buffer, sizeof(buffer) - 1, &size, NULL))
+        return -1;
+    return atoi(buffer);
+}
+
+static LONGLONG read_scr(const BYTE *p)
+{
+    return ((LONGLONG)(p[0] >> 1 & 7) << 30) | (p[1] << 22) | (p[2] >> 1 << 15) | (p[3] << 7) | (p[4] >> 1);
+}
+
+/* An MPEG-1 program stream (what the page decodes): its picture size from the first sequence
+ * header and its duration from the first and last pack's system clock reference. */
+static BOOL probe_mpeg1_ps(HANDLE file, LONG *width, LONG *height, REFERENCE_TIME *duration)
+{
+    enum { SIZE = 65536 };
+    LONGLONG first, last = -1;
+    LARGE_INTEGER size, pos;
+    DWORD len, i;
+    BYTE *buffer;
+    BOOL ret = FALSE;
+
+    if (!(buffer = malloc(SIZE)))
+        return FALSE;
+    if (!ReadFile(file, buffer, SIZE, &len, NULL) || len < 12
+            || buffer[0] || buffer[1] || buffer[2] != 1 || buffer[3] != 0xba || (buffer[4] & 0xf1) != 0x21)
+        goto done;
+    first = read_scr(buffer + 4);
+    *width = *height = 0;
+    for (i = 0; i + 7 <= len; ++i)
+    {
+        if (!buffer[i] && !buffer[i + 1] && buffer[i + 2] == 1 && buffer[i + 3] == 0xb3)
+        {
+            *width = buffer[i + 4] << 4 | buffer[i + 5] >> 4;
+            *height = (buffer[i + 5] & 0xf) << 8 | buffer[i + 6];
+            break;
+        }
+    }
+    if (!*width || !*height)
+        goto done;
+
+    GetFileSizeEx(file, &size);
+    pos.QuadPart = max(0, size.QuadPart - SIZE);
+    if (SetFilePointerEx(file, pos, NULL, FILE_BEGIN) && ReadFile(file, buffer, SIZE, &len, NULL))
+    {
+        for (i = 0; i + 9 <= len; ++i)
+            if (!buffer[i] && !buffer[i + 1] && buffer[i + 2] == 1 && buffer[i + 3] == 0xba && (buffer[i + 4] & 0xf1) == 0x21)
+                last = read_scr(buffer + i + 4);
+    }
+    *duration = last > first ? (last - first) * 1000 / 9 : 0;
+    ret = TRUE;
+done:
+    free(buffer);
+    return ret;
+}
+
+/* Mirrors the video window onto the page and turns the page's end into EC_COMPLETE. */
+static DWORD WINAPI watch_thread(void *arg)
+{
+    struct browser_movie *movie = arg;
+    IMediaEventSink *sink;
+    FILTER_STATE state;
+    IFilterGraph *graph;
+    RECT rect;
+
+    while (WaitForSingleObject(movie->stop_event, 50) == WAIT_TIMEOUT)
+    {
+        EnterCriticalSection(&movie->filter.filter_cs);
+        state = movie->filter.state;
+        graph = movie->filter.graph;
+        LeaveCriticalSection(&movie->filter.filter_cs);
+
+        SetRectEmpty(&rect);
+        if (state != State_Stopped && IsWindowVisible(movie->window.hwnd))
+            GetWindowRect(movie->window.hwnd, &rect);
+        if (!EqualRect(&rect, &movie->shown))
+        {
+            movie->shown = rect;
+            send_command(movie, "rect %ld %ld %ld %ld", rect.left, rect.top,
+                    rect.right - rect.left, rect.bottom - rect.top);
+        }
+
+        if (state == State_Running && !movie->ended && read_status(movie->device) == 1)
+        {
+            movie->ended = TRUE;
+            if (graph && SUCCEEDED(IFilterGraph_QueryInterface(graph, &IID_IMediaEventSink, (void **)&sink)))
+            {
+                IMediaEventSink_Notify(sink, EC_COMPLETE, S_OK, (LONG_PTR)&movie->filter.IBaseFilter_iface);
+                IMediaEventSink_Release(sink);
+            }
+        }
+    }
+    return 0;
+}
